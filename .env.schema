# PluralHost environment schema
# @defaultSensitive=true @defaultRequired=infer

# ─── Database ────────────────────────────────────────────────────────────────

# SQLite connection string — path to the database file
# @type=string @sensitive=false @required
ConnectionStrings__Default=Data Source=pluralhost.db

# ─── JWT ─────────────────────────────────────────────────────────────────────

# HMAC-SHA256 signing key — must be a long random string (32+ bytes recommended)
# @type=string @sensitive @required
Jwt__SigningKey=

# Token issuer/audience — not secret, must match appsettings
# @type=string @sensitive=false
Jwt__Issuer=plural-host

# @type=string @sensitive=false
Jwt__Audience=plural-host

# Token lifetime in hours
# @type=number @sensitive=false
Jwt__ExpiryHours=24

# ─── Storage ─────────────────────────────────────────────────────────────────

# Absolute path to the secure_uploads directory (served behind auth)
# @type=string @sensitive=false @required
SecureUploads__Root=
