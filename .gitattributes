# Normalize line endings to LF on commit, checkout as-is
* text=auto eol=lf

# Force LF for source files regardless of OS
*.cs    text eol=lf
*.tsx   text eol=lf
*.ts    text eol=lf
*.css   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.html  text eol=lf

# Binary — no conversion
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.db    binary
